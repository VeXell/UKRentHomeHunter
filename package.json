  },
  "homepage": "https://github.com/VeXell/UKRentHomeHunter#readme",
  "dependencies": {
    "axios": "^0.21.1",
    "dotenv": "^10.0.0",
    "firebase-admin": "^9.10.0",
    "moment": "^2.29.1",
    "telegraf": "^4.4.0",
    "telegraf-i18n": "^6.6.0"
  },
  "devDependencies": {
    "vxbuildtools": "git+https://git@github.com/VeXell/build-tools.git"
